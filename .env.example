# AI secrets belong in Supabase Edge Function secrets, never in VITE_* variables.
# Configure with:
# supabase secrets set AI_PROVIDER=deepseek AI_MODEL=deepseek-v4-flash
# supabase secrets set DEEPSEEK_API_KEY=your-server-side-key

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase integration credentials
