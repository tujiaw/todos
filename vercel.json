{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/generate-task-draft.ts": {
      "maxDuration": 30
    },
    "api/generate-dashboard-copy.ts": {
      "maxDuration": 30
    },
    "api/generate-weekly-summary.ts": {
      "maxDuration": 30
    },
    "api/generate-ai-assist.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
